generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LicenseStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  licenseConsumptions LicenseConsumption[]
}

model App {
  id        String   @id @default(cuid())
  name      String
  version   Int      @default(1)
  schema    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  records Record[]
  relationRecords RelationRecord[]
  fileMetadata FileMetadata[]
  licenses License[]
}

model License {
  id        String        @id @default(cuid())
  key       String        @unique
  app       App           @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId     String
  customer  String?
  maxUsers  Int           @default(1)
  usedCount Int           @default(0)
  status    LicenseStatus @default(ACTIVE)
  expiresAt DateTime?
  lastUsedAt DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  consumptions LicenseConsumption[]

  @@index([appId])
}

model LicenseConsumption {
  id        String   @id @default(cuid())
  license   License  @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  licenseId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([licenseId, userId])
}

model Record {
  id        String   @id @default(cuid())
  appId     String
  tableId   String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId, tableId])
}

model FileMetadata {
  id        String   @id @default(cuid())
  appId     String
  filename  String
  mimetype  String
  size      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId])
}

model RelationRecord {
  id              String   @id @default(cuid())
  appId           String
  sourceTableId   String
  targetTableId   String
  sourceRecordId  String
  targetRecordId  String
  createdAt       DateTime @default(now())

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId, sourceTableId, sourceRecordId])
  @@index([appId, targetTableId, targetRecordId])
}
